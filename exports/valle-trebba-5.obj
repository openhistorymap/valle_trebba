# Valle Trebba - flat textured plane in real-world dimensions
# Texture: valle-trebba-5.png (2614 x 5000, proportional to the territory;
# AGEA 2011 ortophoto base + georender overlay).
#
# Geo bbox (EPSG:4326)  -- tombe-points bbox + 250m buffer:
#   W 12.10456149  S 44.69634646
#   E 12.11990417  N 44.71727496
#
# Plane on Z=0, +X = east, +Y = north, +Z = up.
# Units: kilometres (1 unit = 1 km).
# Size: 1.2159 (E-W) x 2.3257 (N-S)

mtllib valle-trebba-5.mtl

v 0.000000 0.000000 0.000000
v 1.215900 0.000000 0.000000
v 1.215900 2.325700 0.000000
v 0.000000 2.325700 0.000000

vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000

vn 0.000000 0.000000 1.000000

usemtl valle_trebba
s off
f 1/1/1 2/2/1 3/3/1 4/4/1
