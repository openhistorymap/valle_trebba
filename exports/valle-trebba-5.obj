# Valle Trebba - flat textured plane
# Texture: valle-trebba-5.png (4047 x 5000, proportional to territory;
# AGEA 2011 ortophoto base + georender overlay).
#
# Geo bbox (EPSG:4326)  -- tombe-points bbox + 2000m buffer:
#   W 12.08247890  S 44.68059874
#   E 12.14198675  N 44.73302268
#
# Plane on Z=0, +X = east, +Y = north, +Z = up.
# Units: kilometres (1 unit = 1 km).
# Size: 4.7159 (E-W) x 5.8257 (N-S)

mtllib valle-trebba-5.mtl

v 0.000000 0.000000 0.000000
v 4.715900 0.000000 0.000000
v 4.715900 5.825700 0.000000
v 0.000000 5.825700 0.000000

vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000

vn 0.000000 0.000000 1.000000

usemtl valle_trebba
s off
f 1/1/1 2/2/1 3/3/1 4/4/1
