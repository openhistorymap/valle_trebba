  "layers": [
    {
      "name": "Tombe",
      "type": "features",
      "datasource": "valle_trebba_punti_32632",
      "style": {
        "style": "mapbox",
        "mode": "marker",
        "markerType": "circle",
        "options": {
          "radius": 4,
          "fillColor": "#e77148",
          "color": "#000",
          "weight": 1,
          "opacity": 1,
          "fillOpacity": 0.6
        },
        "maplibre": [
          {
            "type": "circle",
            "filter": ["==", ["geometry-type"], "Point"],
            "paint": {
              "circle-radius": [
                "interpolate", ["linear"], ["zoom"],
                12, 2,
                16, 4,
                20, 7
              ],
              "circle-color": [
                "match", ["get", "t_rito"],
                "inumazione", "#5b8def",
                "cremazione", "#e77148",
                "#b0b0b0"
              ],
              "circle-stroke-color": "#000",
              "circle-stroke-width": 0.5,
              "circle-opacity": 0.9
            }
          }
        ]
      },
      "detail": {
        "title": "tomba",
        "media": [
          { "kind": "image", "src": "schizzi/{tomba}.jpg", "label": "Schizzo" },
          { "kind": "html", "src": "tombe/VT_Tomba_{tomba}.html", "label": "Scheda di scavo" },
          { "kind": "csv-row", "src": "Tombe_VT_151-1213.csv",
            "key": "Tomba n°:", "match": "{tomba}",
            "label": "Metadati tomba" },
          { "kind": "csv-row", "src": "Bibliografia_tombe_171-1213.csv",
            "key": "N. Tomba", "match": "{tomba}",
            "label": "Bibliografia essenziale" },
          { "kind": "download", "src": "tombe/VT_Tomba_{tomba}.docx", "label": "Versione DOCX" }
        ]
      }
    },
    {
      "name": "Ustrina",
      "type": "features",
